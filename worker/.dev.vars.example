# ═══════════════════════════════════════════════════════════════════════════
#  CLAVES SECRETAS
#  El botón "Deploy to Cloudflare" te pide estos valores al instalar y los
#  guarda CIFRADOS. No tienes que tocar este archivo.
# ═══════════════════════════════════════════════════════════════════════════

# OBLIGATORIO — El "Client Secret" de tu app de Shopify (Dev Dashboard). Secreto.
SHOPIFY_CLIENT_SECRET=

# RECOMENDADO — Contraseña (la inventas tú) para entrar a tu panel de bloqueos /admin.
ADMIN_SECRET=

# ── OPCIONALES (Meta / TikTok) ─────────────────────────────────────────────
# Para enviar eventos a Meta o TikTok por servidor. NO se piden al instalar.
# Si algún día los usas, agrégalos después en:
#   Cloudflare → tu worker → Settings → Variables and Secrets → Add
# con los nombres:  META_CAPI_TOKEN   y   TIKTOK_ACCESS_TOKEN
